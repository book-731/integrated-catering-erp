# npm run setup:env 會將佔位符替換為隨機本機密碼；不要提交 .env。
POSTGRES_USER=erp
POSTGRES_PASSWORD=__LOCAL_DB_PASSWORD__
POSTGRES_DB=restaurant_erp
POSTGRES_PORT=55432
DATABASE_URL=postgresql://erp:__LOCAL_DB_PASSWORD__@127.0.0.1:55432/restaurant_erp?schema=public
# 僅供隔離整合測試；測試指令不會使用 DATABASE_URL。
TEST_DATABASE_URL=postgresql://erp_test:__LOCAL_DB_PASSWORD__@127.0.0.1:55433/restaurant_erp_test?schema=public
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
APP_ORIGIN=http://127.0.0.1:5173
# 本機 HTTP 開發用 false；非本機部署必須 HTTPS + true。
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_ACCOUNT=10
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

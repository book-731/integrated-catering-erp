// v0.4：單店 ERP；新增業務表以加法 Migration 保留既有資料。
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
  KITCHEN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  displayName  String   @db.VarChar(100)
  passwordHash String   @db.VarChar(255)
  role         Role
  isActive     Boolean  @default(true)
  authVersion  Int      @default(0)
  sessions     Session[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@map("users")
}

model Session {
  id          String   @id @db.Char(64)
  csrfToken   String   @db.VarChar(64)
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  authVersion Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime @db.Timestamptz(3)
  expiresAt   DateTime @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthRateLimit {
  key     String   @id @db.Char(64)
  count   Int
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
  @@map("auth_rate_limits")
}

model Ingredient {
  id            String   @id @default(uuid()) @db.Uuid
  sku           String   @unique @db.VarChar(64)
  name          String   @db.VarChar(100)
  unit          String   @db.VarChar(20)
  stockQuantity Decimal  @default(0) @db.Decimal(14, 3)
  safetyStock   Decimal  @default(0) @db.Decimal(14, 3)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  recipes       RecipeIngredient[]
  movements StockMovement[]
  optionRecipes OptionRecipe[]
  purchaseLines PurchaseLine[]

  @@map("ingredients")
}

model MenuCategory {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique @db.VarChar(100)
  isActive  Boolean    @default(true)
  menuItems MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @db.VarChar(2048)
  isActive    Boolean  @default(true)
  isAvailable Boolean  @default(true)
  recipeVersion Int    @default(0)
  categoryId  String   @db.Uuid
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  recipes     RecipeIngredient[]
  bundleParts BundlePart[] @relation("BundleParent")
  includedIn BundlePart[] @relation("BundleChild")
  optionGroups OptionGroup[]
  orderLines OrderLine[]

  @@index([categoryId])
  @@map("menu_items")
}

model BundlePart {
  parentId String @db.Uuid
  childId String @db.Uuid
  quantity Int
  parent MenuItem @relation("BundleParent",fields:[parentId],references:[id],onDelete:Restrict)
  child MenuItem @relation("BundleChild",fields:[childId],references:[id],onDelete:Restrict)
  @@id([parentId,childId])
  @@map("bundle_parts")
}
model OptionGroup {
  id String @id @default(uuid()) @db.Uuid
  menuItemId String @db.Uuid
  name String @db.VarChar(100)
  minSelect Int @default(0)
  maxSelect Int @default(1)
  isActive Boolean @default(true)
  menuItem MenuItem @relation(fields:[menuItemId],references:[id],onDelete:Restrict)
  options MenuOption[]
  @@map("option_groups")
}
model MenuOption {
  id String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  name String @db.VarChar(100)
  price Decimal @db.Decimal(12,2)
  isActive Boolean @default(true)
  group OptionGroup @relation(fields:[groupId],references:[id],onDelete:Restrict)
  recipes OptionRecipe[]
  @@map("menu_options")
}
model OptionRecipe {
  optionId String @db.Uuid
  ingredientId String @db.Uuid
  quantity Decimal @db.Decimal(14,3)
  option MenuOption @relation(fields:[optionId],references:[id],onDelete:Restrict)
  ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
  @@id([optionId,ingredientId])
  @@map("option_recipes")
}
model CommandReceipt {
  id String @id @db.VarChar(180)
  hash String @db.Char(64)
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@map("command_receipts")
}
model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  ingredientId String @db.Uuid
  ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
  type String @db.VarChar(30)
  quantity Decimal @db.Decimal(14,3)
  before Decimal @db.Decimal(14,3)
  after Decimal @db.Decimal(14,3)
  unit String @db.VarChar(20)
  reason String @db.VarChar(500)
  actorId String? @db.Uuid
  source String @db.VarChar(180)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([source,ingredientId])
  @@index([ingredientId,createdAt])
  @@map("stock_movements")
}
model Order {
  id String @id @default(uuid()) @db.Uuid
  type String @db.VarChar(20)
  reference String @db.VarChar(200)
  status String @default("PENDING") @db.VarChar(20)
  revision Int @default(0)
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @db.Decimal(12,2)
  serviceFee Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  paymentMethod String? @db.VarChar(20)
  paidAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lines OrderLine[]
  @@index([createdAt,status])
  @@map("orders")
}
model OrderLine {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  menuItemId String @db.Uuid
  name String @db.VarChar(100)
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  snapshot Json
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  menuItem MenuItem @relation(fields:[menuItemId],references:[id],onDelete:Restrict)
  @@index([orderId])
  @@map("order_lines")
}
model Supplier {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  contact String @db.VarChar(200)
  isActive Boolean @default(true)
  purchases Purchase[]
  @@map("suppliers")
}
model Purchase {
  id String @id @default(uuid()) @db.Uuid
  supplierId String @db.Uuid
  supplier Supplier @relation(fields:[supplierId],references:[id],onDelete:Restrict)
  status String @default("REQUESTED") @db.VarChar(20)
  note String @db.VarChar(500)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lines PurchaseLine[]
  receipts GoodsReceipt[]
  @@map("purchases")
}
model PurchaseLine {
  id String @id @default(uuid()) @db.Uuid
  purchaseId String @db.Uuid
  ingredientId String @db.Uuid
  unit String @db.VarChar(20)
  quantity Decimal @db.Decimal(14,3)
  received Decimal @default(0) @db.Decimal(14,3)
  unitCost Decimal @db.Decimal(12,2)
  purchase Purchase @relation(fields:[purchaseId],references:[id],onDelete:Restrict)
  ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
  @@unique([purchaseId,ingredientId])
  @@map("purchase_lines")
}
model GoodsReceipt {
  id String @id @default(uuid()) @db.Uuid
  purchaseId String @db.Uuid
  purchase Purchase @relation(fields:[purchaseId],references:[id],onDelete:Restrict)
  lines Json
  actorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@map("goods_receipts")
}
model Job {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  isActive Boolean @default(true)
  employees Employee[]
  @@map("jobs")
}
model Employee {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(64)
  name String @db.VarChar(100)
  contact String @db.VarChar(200)
  jobId String @db.Uuid
  job Job @relation(fields:[jobId],references:[id],onDelete:Restrict)
  isActive Boolean @default(true)
  shifts Shift[]
  attendance Attendance[]
  leaves Leave[]
  @@map("employees")
}
model Shift {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  start DateTime @db.Timestamptz(3)
  end DateTime @db.Timestamptz(3)
  note String @db.VarChar(500)
  isActive Boolean @default(true)
  @@index([employeeId,start,end])
  @@map("shifts")
}
model Attendance {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  start DateTime @db.Timestamptz(3)
  end DateTime? @db.Timestamptz(3)
  note String @db.VarChar(500)
  actorId String @db.Uuid
  @@map("attendance")
}
model Leave {
  id String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  start DateTime @db.Timestamptz(3)
  end DateTime @db.Timestamptz(3)
  reason String @db.VarChar(500)
  status String @default("REQUESTED") @db.VarChar(20)
  actorId String @db.Uuid
  @@map("leaves")
}

model RecipeIngredient {
  menuItemId   String     @db.Uuid
  ingredientId String     @db.Uuid
  quantity     Decimal    @db.Decimal(14, 3)
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([menuItemId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}
